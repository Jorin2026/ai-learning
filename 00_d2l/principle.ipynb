   "source": [
    "w = 0.0 \n",
    "lr = 0.1 \n",
    "for step in range(30):\n",
    "    loss = (w-3)**2 \n",
    "    grad = 2 * (w-3) \n",
    "    w = w - lr * grad \n",
    "    print(step,round(w,4),round(loss,4))"
   ]
