       "\u001b[31mInit signature:\u001b[39m data.TensorDataset(*tensors: torch.Tensor) -> \u001b[38;5;28;01mNone\u001b[39;00m\n",
       "\u001b[31mSource:\u001b[39m        \n",
       "\u001b[38;5;28;01mclass\u001b[39;00m TensorDataset(Dataset[tuple[Tensor, ...]]):\n",
       "    \u001b[33mr\"\"\"Dataset wrapping tensors.\u001b[39m\n",
       "\n",
       "\u001b[33m    Each sample will be retrieved by indexing tensors along the first dimension.\u001b[39m\n",
       "\n",
       "\u001b[33m    Args:\u001b[39m\n",
       "\u001b[33m        *tensors (Tensor): tensors that have the same size of the first dimension.\u001b[39m\n",
       "\u001b[33m    \"\"\"\u001b[39m\n",
       "\n",
       "    tensors: tuple[Tensor, ...]\n",
       "\n",
       "    \u001b[38;5;28;01mdef\u001b[39;00m __init__(self, *tensors: Tensor) -> \u001b[38;5;28;01mNone\u001b[39;00m:\n",
       "        \u001b[38;5;28;01mif\u001b[39;00m any(tensors[\u001b[32m0\u001b[39m].size(\u001b[32m0\u001b[39m) != tensor.size(\u001b[32m0\u001b[39m) \u001b[38;5;28;01mfor\u001b[39;00m tensor \u001b[38;5;28;01min\u001b[39;00m tensors):\n",
       "            \u001b[38;5;28;01mraise\u001b[39;00m AssertionError(\u001b[33m\"Size mismatch between tensors\"\u001b[39m)\n",
       "        self.tensors = tensors\n",
       "\n",
       "    \u001b[38;5;28;01mdef\u001b[39;00m __getitem__(self, index):\n",
       "        \u001b[38;5;28;01mreturn\u001b[39;00m tuple(tensor[index] \u001b[38;5;28;01mfor\u001b[39;00m tensor \u001b[38;5;28;01min\u001b[39;00m self.tensors)\n",
       "\n",
       "    \u001b[38;5;28;01mdef\u001b[39;00m __len__(self) -> int:\n",
       "        \u001b[38;5;28;01mreturn\u001b[39;00m self.tensors[\u001b[32m0\u001b[39m].size(\u001b[32m0\u001b[39m)\n",
       "\u001b[31mFile:\u001b[39m           /opt/homebrew/Caskroom/miniconda/base/envs/ailearn/lib/python3.11/site-packages/torch/utils/data/dataset.py\n",
